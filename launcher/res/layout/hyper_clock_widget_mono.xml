<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hyper_clock_root" android:layout_width="match_parent" android:layout_height="124dp"
    android:background="@drawable/hyper_widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextClock
            android:id="@+id/hyper_clock_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textSize="48sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.02"
            android:textColor="#FFFFFFFF"
            android:maxLines="1" />

        <TextClock
            android:id="@+id/hyper_clock_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:format12Hour="yyyy.MM.dd  EEE"
            android:format24Hour="yyyy.MM.dd  EEE"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textColor="#FF9ABCFF"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/hyper_clock_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:padding="12dp"
        android:text="⚙"
        android:textSize="16sp"
        android:textColor="#99FFFFFF"
        android:contentDescription="@string/hyper_clock_style" />
</FrameLayout>
