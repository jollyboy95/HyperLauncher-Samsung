<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hyper_clock_root" android:layout_width="match_parent" android:layout_height="124dp"
    android:background="@drawable/hyper_widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="14dp">

        <TextClock
            android:id="@+id/hyper_clock_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textSize="52sp"
            android:fontFamily="sans-serif-thin"
            android:textColor="#FFFFFFFF"
            android:maxLines="1" />

        <TextClock
            android:id="@+id/hyper_clock_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE, d MMMM"
            android:format24Hour="EEEE, d MMMM"
            android:textSize="12sp"
            android:letterSpacing="0.18"
            android:textAllCaps="true"
            android:textColor="#FFD8DFEA"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/hyper_clock_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:padding="12dp"
        android:text="⚙"
        android:textSize="16sp"
        android:textColor="#99FFFFFF"
        android:contentDescription="@string/hyper_clock_style" />
</FrameLayout>
