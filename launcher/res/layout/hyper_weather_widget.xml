<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hyper_weather_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="148dp"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="@drawable/hyper_weather_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hyper_weather_city"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hyper_weather_setup_title"
                android:textSize="14sp"
                android:textColor="#E6FFFFFF"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/hyper_weather_temp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--°"
                android:textSize="48sp"
                android:fontFamily="sans-serif-light"
                android:textColor="#FFFFFFFF"
                android:maxLines="1" />

            <TextView
                android:id="@+id/hyper_weather_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hyper_weather_setup_hint"
                android:textSize="13sp"
                android:textColor="#FFCAD2E0"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageView
            android:id="@+id/hyper_weather_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/hyper_wx_partly"
            android:contentDescription="@string/hyper_weather_icon_description" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/hyper_weather_updated"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/hyper_weather_attribution"
            android:textSize="10sp"
            android:textColor="#99FFFFFF"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hyper_weather_attribution"
            android:textSize="9sp"
            android:textColor="#80FFFFFF" />
    </LinearLayout>
</LinearLayout>
